#!/sbin/sh
# Standard Magisk module installer entry point (also accepted by KernelSU and APatch managers, which
# run their own installer and ignore this file). It hands over to Magisk's install_module, which
# extracts the zip, sources customize.sh and applies set_permissions().

umask 022

ui_print() {
    echo "$1"
}

require_new_magisk() {
    ui_print "*******************************"
    ui_print " Please install Magisk v20.4+! "
    ui_print "*******************************"
    exit 1
}

# shellcheck disable=SC2034  # OUTFD and ZIPFILE are read by Magisk's util_functions.sh
OUTFD=$2
# shellcheck disable=SC2034
ZIPFILE=$3

mount /data 2> /dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
# shellcheck disable=SC1091
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk

install_module
exit 0
